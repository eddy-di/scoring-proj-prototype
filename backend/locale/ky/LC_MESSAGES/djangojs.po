#: js/views/respondent.js:63
msgid "Hello, {name}"
msgstr "Саламатсызбы, {name}"

#: js/main.js:53 js/views/help.js:16
msgid "Help"
msgstr "Жардам"

#: js/main.js:70 js/views/help.js:18
